<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.cafecli</groupId>
    <artifactId>cafecli</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Cafecli</name>
    <description>A simple Java Agent CLI like Claude Code</description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 日常打包优先给手工验收产物；回归测试用 mvn test -Pquick / -Pphase16-smoke / -DskipTests=false 显式触发。 -->
        <skipTests>true</skipTests>
        <!--
          测试期把两项「嗅探 TERM_PROGRAM」的终端能力钉死。`TerminalCapabilities` 的
          synchronized-output(DEC 2026) 与 osc8 探测在 `terminal.getType()` 不认识时会回退去读进程的
          `TERM_PROGRAM` 环境变量——那是**跑 Maven 的那个终端**，不是测试里 mock 出来的 Terminal。
          于是同一份代码在 Ghostty / iTerm 下渲染出的帧字节和在 Apple Terminal / CI 下不同：
          实测 `InlineRendererTest` 在 TERM_PROGRAM=ghostty 下 5 红、unset 下全绿（2026-09-03）。
          钉死之后 mock 才是唯一的能力来源，本地与 CI 才等价。
          包裹帧的那两个序列由 `RenderLoopTest.synchronizedOutputWrapsOneCompleteFrame` 直接传
          构造参数覆盖，钉这里不丢覆盖。

          **不要**把 `paicli.render.color` 也加进来：实测钉成 false 会让 `ScreenTruthRegressionTest`
          的两条依赖彩色输出的断言变红，并让 `AnsiStyleTest` 里两条 `assumeTrue(isEnabled())`
          静默 skip（skip 在日志里读起来和 pass 一样）。色彩的顺序依赖已在测试侧根治：不再有任何
          测试写 `paicli.render.color` 这个全局。
        -->
        <test.argLine>-Dfile.encoding=UTF-8 -Dpaicli.render.synchronized-output=false -Dpaicli.render.osc8=false</test.argLine>
    </properties>

    <dependencies>
        <!-- JSON处理 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.16.0</version>
        </dependency>

        <!-- HTTP客户端 -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>4.12.0</version>
        </dependency>

        <!-- 日志 -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.5.18</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>

        <!-- JLine for terminal input, status area and interactive widgets -->
        <dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline</artifactId>
            <version>4.0.0</version>
            <classifier>jdk11</classifier>
        </dependency>

        <!-- 中文分词 -->
        <dependency>
            <groupId>com.huaban</groupId>
            <artifactId>jieba-analysis</artifactId>
            <version>1.0.2</version>
        </dependency>

        <!-- SQLite -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.49.1.0</version>
        </dependency>

        <!-- Java AST 解析 -->
        <dependency>
            <groupId>com.github.javaparser</groupId>
            <artifactId>javaparser-core</artifactId>
            <version>3.28.0</version>
        </dependency>

        <!-- Side-Git 快照（纯 Java，不依赖系统 git） -->
        <dependency>
            <groupId>org.eclipse.jgit</groupId>
            <artifactId>org.eclipse.jgit</artifactId>
            <version>7.6.0.202603022253-r</version>
        </dependency>

        <!-- HTML 解析（用于 web_fetch 正文提取） -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.18.1</version>
        </dependency>

        <!-- OkHttp MockWebServer（仅测试） -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
            <version>4.12.0</version>
            <scope>test</scope>
        </dependency>

        <!-- ArchUnit（仅测试，v2 分层规则：V2ArchitectureTest） -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.5.1</version>
            <scope>test</scope>
        </dependency>

        <!-- Mockito（仅测试，render/inline 模块用 mock Terminal） -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.11.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <forceCreation>true</forceCreation>
                    <archive>
                        <manifest>
                            <mainClass>com.cafecli.cli.Main</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <argLine>${test.argLine}</argLine>
                    <skipTests>${skipTests}</skipTests>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.cafecli.cli.Main</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

